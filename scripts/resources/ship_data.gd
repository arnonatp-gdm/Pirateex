## ShipData – data-driven resource for a ship type.
class_name ShipData
extends Resource

@export var ship_name: String = ""
@export var ship_type: String = "corvette"
## Base Star Pearls the ship starts with.
@export var base_sp: int = 100
## Base Moon Pearls the ship starts with.
@export var base_mp: int = 100
## Maximum number of upgrades.
@export var upgrade_slots: int = 3
@export var description: String = ""
